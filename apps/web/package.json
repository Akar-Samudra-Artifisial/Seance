{
  "name": "@seance/web",
  "version": "0.0.0",
  "private": true,
  "description": "Séance retro web client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
