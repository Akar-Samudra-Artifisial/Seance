# Documentation only. Contains no secrets. Copy values into your shell or process manager.

# Default Ircd WebSocket URL (ws: or wss:). Read by the web server per request: restart after changing it.
# Changing it changes the CSP connect-src, and the origin of this URL is the only
# non-local WebSocket origin the page may open.
NEXT_PUBLIC_IRCD_WS_URL=ws://127.0.0.1:6680

# Read by the Ircd (apps/ircd), not by the web app. Comma-separated page origins allowed to
# open a WebSocket, or *. localhost and 127.0.0.1 are different origins: list the one in use.
IRCD_WS_ALLOWED_ORIGINS=http://localhost:3000
