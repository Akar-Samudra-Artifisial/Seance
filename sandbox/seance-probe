#!/bin/sh
# Network isolation probe of the Séance sandbox image (agent-sandbox Requirements 3.3, 7.7).
# Usage: seance-probe <host-loopback-port> [<ipv4>:<port> ...]
# Exit codes (the launcher's table, apps/runner/src/sandbox/flags.ts PROBE_EXIT):
#   0   nothing reachable
#   10  the host loopback listener is reachable through the default gateway
#   11  the metadata endpoint 169.254.169.254:80 is reachable
#   12  nc is missing
#   13  an extra target (outside the egress allow-list) is reachable
#   2   usage error
set -u

port=${1:-}
case "$port" in
  '' | *[!0-9]*) echo "usage: seance-probe <port> [<ipv4>:<port> ...]" >&2; exit 2 ;;
esac
shift

command -v nc >/dev/null 2>&1 || { echo "seance-probe: nc not found" >&2; exit 12; }

# TCP connect with a 2 second bound; 0 means connected.
reach() {
  nc -z -w 2 "$1" "$2" >/dev/null 2>&1
}

# Default gateway from /proc/net/route (little-endian hex), converted without gawk extensions.
gateway=$(awk '
  function hx(s,   i, v) { v = 0; for (i = 1; i <= length(s); i++) v = v * 16 + index("0123456789ABCDEF", toupper(substr(s, i, 1))) - 1; return v }
  NR > 1 && $2 == "00000000" { g = $3; printf "%d.%d.%d.%d\n", hx(substr(g, 7, 2)), hx(substr(g, 5, 2)), hx(substr(g, 3, 2)), hx(substr(g, 1, 2)); exit }
' /proc/net/route 2>/dev/null)

if [ -n "$gateway" ] && reach "$gateway" "$port"; then
  echo "seance-probe: host loopback reachable via $gateway:$port" >&2
  exit 10
fi

if reach 169.254.169.254 80; then
  echo "seance-probe: metadata endpoint reachable" >&2
  exit 11
fi

for target in "$@"; do
  host=${target%:*}
  tport=${target##*:}
  if reach "$host" "$tport"; then
    echo "seance-probe: $target reachable (outside the egress allow-list)" >&2
    exit 13
  fi
done

exit 0
