# Séance on the public judge server (spec deploy-aws). bootstrap.sh renders this file to
# /etc/seance/seance.env (mode 0600, root) on the first run, filling every @PLACEHOLDER@; later runs
# never overwrite it. systemd reads it for seance-ircd (EnvironmentFile=). The "web" section goes to
# /etc/seance/web.env, so the web process never sees the server password.
# Never commit a filled-in copy.

# ---- ircd ------------------------------------------------------------------------------------
IRCD_PUBLIC=1
# Loopback only: Caddy terminates TLS on 443 and proxies /ws to 6680. TCP 6667 is not reachable
# from outside (see docs/DEPLOY.md, "Classic clients").
IRCD_HOST=127.0.0.1
IRCD_TCP_PORT=6667
IRCD_WS_PORT=6680
IRCD_SERVER_NAME=@SEANCE_PUBLIC_HOSTNAME@
# Guest login (chat only, guests cannot invite agents). 20+ characters; generated by bootstrap.sh.
IRCD_SERVER_PASSWORD=@GENERATED_SERVER_PASSWORD@
# One line per judge: node tools/seance-account.mjs <nick> >> /etc/seance/accounts (mode 0600, seance).
IRCD_ACCOUNTS_FILE=/etc/seance/accounts
# The page origin; https only, never "*".
IRCD_WS_ALLOWED_ORIGINS=https://@SEANCE_PUBLIC_HOSTNAME@
# Caddy on the same host; it overwrites X-Forwarded-For (deploy/Caddyfile).
IRCD_TRUSTED_PROXIES=127.0.0.1,::1
IRCD_MAX_CONNECTIONS=200
IRCD_MAX_CONNECTIONS_PER_IP=5
IRCD_MAX_PASS_FAILURES_PER_IP=10
IRCD_REGISTRATION_TIMEOUT_MS=15000
IRCD_FLOOD_BURST=10
IRCD_FLOOD_REFILL_MS=1000

# ---- runner ----------------------------------------------------------------------------------
SEANCE_RUNNER=1
SEANCE_HARNESS=acp
SEANCE_AGENTS_DIR=/opt/seance/agents
SEANCE_TARGET_REPO=/srv/seance/target
# The XFS volume with a hard project quota (bootstrap.sh).
SEANCE_WORKSPACES=/srv/seance/workspaces
# Account nicks (from IRCD_ACCOUNTS_FILE) that may invite agents and reset credits.
SEANCE_INVITERS=@SET_ME_ACCOUNT_NICKS@
SEANCE_INVITE_RATE=3
SEANCE_PROMPT_TIMEOUT_MS=120000

# Credit caps for a public demo on a 4,000-credit budget (docs/DEPLOY.md, "Credit caps"):
# 100 credits per UTC day for all agents and private sessions together (30 days = 3,000 at most,
# 1,000 left for the spike, smoke tests and mistakes); a channel is blocked at 30 until an
# authenticated inviter with +o sends !reset-credits.
SEANCE_DAILY_CREDIT_CAP=100
SEANCE_CHANNEL_CREDIT_CAP=30
SEANCE_MAX_AGENT_CHANNELS=2
# t3.medium has 4 GiB: three containers of 768 MiB leave room for node, Next and Caddy.
SEANCE_MAX_CONTAINERS=3
SEANCE_GIT_TIMEOUT_MS=60000
SEANCE_WORKTREE_MAX_BYTES=524288000
SEANCE_KILL_SWITCH_FILE=/srv/seance/workspaces/.seance-paused

# ---- sandbox (rootless Podman 5) -------------------------------------------------------------
SEANCE_SANDBOX=podman
SEANCE_PODMAN_BIN=/usr/bin/podman
# Built by bootstrap.sh from sandbox/Dockerfile and pinned by digest.
SEANCE_SANDBOX_IMAGE=@SANDBOX_IMAGE_DIGEST_REF@
# Kiro credential: SEANCE_SANDBOX_AUTH_DIR, KIRO_API_KEY, or both (one is required). With both,
# the login wins. The login of the seance user (kiro-cli login --use-device-flow, docs/DEPLOY.md). Mode 0700.
# Optional when KIRO_API_KEY (below) is set. A non-blank value enables the Kiro login refresh timer
# and the ircd login-directory check. On a KIRO_API_KEY-only host, delete this line or comment it out
# (or leave it blank): bootstrap.sh then does not enable the refresh timer and the ircd unit skips the check.
# It stays uncommented here as the default for a login host.
SEANCE_SANDBOX_AUTH_DIR=/home/seance/.local/share/kiro-cli
SEANCE_SANDBOX_KIRO_BIN=kiro-cli
SEANCE_SANDBOX_MEMORY=768m
SEANCE_SANDBOX_CPUS=1
SEANCE_SANDBOX_PIDS=256
SEANCE_SANDBOX_TIMEOUT_S=86400
# An agent with no activity for this long (seconds, 60-86400) is released like a /kick: its container
# stops and the memory is freed. Applies in both sandbox modes. 900 = 15 min.
SEANCE_IDLE_TIMEOUT_S=900
# The default VPC and the other private ranges; the host rule (sandbox/seance-sandbox.nft) drops them.
SEANCE_SANDBOX_BLOCKED_CIDRS=@VPC_CIDR@,10.0.0.0/8,192.168.0.0/16
SEANCE_SANDBOX_EGRESS_PROBES=1.1.1.1:443

# ---- process -----------------------------------------------------------------------------------
NODE_ENV=production
# Rootless Podman of the seance user (linger is on).
XDG_RUNTIME_DIR=/run/user/@SEANCE_UID@
# For a key-only host: uncomment this line, set a real key on the host only (never commit it), and remove
# SEANCE_SANDBOX_AUTH_DIR above.
# Optional instead of (or with) SEANCE_SANDBOX_AUTH_DIR: forwarded name-only into each agent container,
# never in argv. Public host: a dedicated, revocable key, bounded by the credit caps below (docs/SANDBOX.md); revoke after January 29, 2027.
# KIRO_API_KEY=<your-kiro-api-key>

# ---- web (bootstrap.sh writes these two lines to /etc/seance/web.env) ------------------------
# NEXT_PUBLIC_IRCD_WS_URL=wss://@SEANCE_PUBLIC_HOSTNAME@/ws
# NEXT_TELEMETRY_DISABLED=1
