# Pinned downloads for deploy/bootstrap.sh (spec deploy-aws). Sourced by bootstrap.sh; every value
# is required and checked (fail closed).
#
# KIRO_INSTALLER_SHA256 is the sha256 of the script at KIRO_INSTALLER_URL. The installer itself
# checks the kiro-cli package against the sha256 in Kiro's release manifest. When Kiro publishes a
# new installer, bootstrap.sh stops with "checksum mismatch". To update the pin:
#   curl -fsSLo kiro-install.sh https://cli.kiro.dev/install
#   less kiro-install.sh                 # read it: it must only download from prod.download.cli.kiro.dev
#   sha256sum kiro-install.sh            # (macOS: shasum -a 256 kiro-install.sh)
# then put the new value here, commit, and deploy that commit (deploy/update.sh <sha>).
KIRO_INSTALLER_URL=https://cli.kiro.dev/install
KIRO_INSTALLER_SHA256=a8bce4c6b740deb61009e3ad10995ec3027a51e6345025f1a2e5048ffdbf4b84
